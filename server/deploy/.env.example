# Copy to .env and fill in. See docs/DEPLOY.md.

# Domain with A/AAAA records for api., relay. (and dns. if used).
DOMAIN=example.org
# Public IPv4 of the server (DNS answers for the discovery service).
PUBLIC_IP=203.0.113.10
# Contact for Let's Encrypt.
ACME_EMAIL=admin@example.org

# Push service. Text of the iOS notification when the organization sets none.
PUSH_DEFAULT_TEXT=New updates
# Firebase service account (JSON) and APNs key (.p8), mounted from ./secrets.
FCM_SERVICE_ACCOUNT_FILE=/secrets/fcm-service-account.json
APNS_KEY_FILE=/secrets/apns-key.p8
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_SANDBOX=false
